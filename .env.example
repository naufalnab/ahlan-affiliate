# Production PostgreSQL connection string (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
# Direct URL for migrations / connection poolers (optional, if provider requires it)
DIRECT_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Enable demo fallback explicitly if needed
DEMO_MODE="false"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
